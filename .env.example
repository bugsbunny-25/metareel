# Server
APP_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_SHUTDOWN_TIMEOUT=10s

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=

# SQLite (file-backed, WAL-enabled via DSN params)
DATABASE_URL=file:./data/metareel.db?_pragma=journal_mode(WAL)&_pragma=busy_timeout(5000)&_pragma=foreign_keys(1)
DATABASE_MIGRATIONS_DIR=db/migrations

# For Goose CLI usage (Makefile): prefer a plain path (no `file:` URL, no pragmas)
DATABASE_PATH=./data/metareel.db

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DEFAULT_TTL=5m

# Asynq
ASYNQ_QUEUE=default
ASYNQ_CONCURRENCY=10

# HTTP client (Resty)
HTTP_CLIENT_TIMEOUT=20s
HTTP_CLIENT_RETRY_COUNT=2
HTTP_CLIENT_USER_AGENT=metareel/0.1

# Scraper (Colly)
SCRAPER_USER_AGENT=metareel-bot/0.1
SCRAPER_PARALLELISM=4
SCRAPER_REQUEST_TIMEOUT=20s

# FlareSolverr (optional): when set, FlixPatrol pages are fetched through it
# instead of Colly, e.g. http://flaresolverr:8191 inside docker compose.
FLARESOLVERR_URL=
FLARESOLVERR_MAX_TIMEOUT=60s
FLARESOLVERR_SESSION=metareel
FLARESOLVERR_SESSION_TTL=30m

# UI
UI_STATIC_DIR=web/dist
UI_SERVE_STATIC=true

# TMDB (for mapping titles -> TMDB/IMDB IDs; also gives ratings a title/year)
TMDB_API_KEY=

# Ratings (GET /api/v1/titles/tmdb/{movie|tv}/{id}/ratings)
RATINGS_TTL=12h
# justwatch | mdblist: which provider wins when both have an IMDb / RT value
RATINGS_PREFERRED_PROVIDER=justwatch
# Optional: also fetch ratings from MDBList (free tier: 1,000 requests/day)
MDBLIST_API_KEY=
