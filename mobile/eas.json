{
  "cli": {
    "version": ">= 27.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "development-simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "android": { "buildType": "apk" }
    },
    "release-apk": {
      "distribution": "internal",
      "channel": "production",
      "environment": "production",
      "android": { "buildType": "apk" }
    },
    "production": {
      "channel": "production",
      "environment": "production"
    }
  },
  "submit": {
    "production": {
      "ios": { "ascAppId": "6835131885" }
    }
  }
}
