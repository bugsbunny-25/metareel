    "expo-image": "~58.0.19",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.23",
    "expo-network": "~58.0.6",
    "expo-notifications": "~58.1.10",
    "expo-router": "~58.0.33",
